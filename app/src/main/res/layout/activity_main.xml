<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/TXTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appTitle"
        android:textSize="@dimen/TXTitle"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/MarginTopFirts"
        />
    <GridLayout
        android:id="@+id/GRLTablero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/TXTitle"
        android:layout_marginTop="@dimen/MarginTop"
        android:layout_centerHorizontal="true"
        android:columnCount="4"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        >
        <Button
            android:id="@+id/BTN00"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="1"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN01"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="2"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN02"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="3"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN03"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="4"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN10"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="5"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN11"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="6"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN12"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="7"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN13"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="8"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN20"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="9"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN21"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="10"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN22"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="11"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN23"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="12"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN30"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="13"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN31"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="14"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN32"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:text="15"
            android:textSize="@dimen/TextSize"
            />
        <Button
            android:id="@+id/BTN33"
            android:layout_width="@dimen/ButtonWidth"
            android:layout_height="@dimen/ButtonHeight"
            android:layout_margin="@dimen/ButtonMargin"
            android:textSize="@dimen/TextSize"
            />
    </GridLayout>
    <TextView
        android:id="@+id/TXTPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/GRLTablero"
        android:text="@string/Mensaje"
        android:textSize="@dimen/TXSEasy"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/MarginTop"
        android:textColor="@color/purple_700"
        />
    <Button
        android:id="@+id/BTNRestart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/TXTPlayer"
        android:layout_centerHorizontal="true"
        android:text="@string/Restart"
        android:layout_marginTop="@dimen/MarginTop"
        android:textSize="@dimen/TXSEasy"
        android:visibility="visible"

        />
    <Button
        android:id="@+id/BTNMess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/BTNRestart"
        android:layout_centerHorizontal="true"
        android:text="@string/BTMess"
        android:layout_marginTop="@dimen/MarginTop"
        android:textSize="@dimen/TXSEasy"
        android:visibility="visible"
        />
    <Button
        android:id="@+id/BTNVerify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/BTNMess"
        android:layout_centerHorizontal="true"
        android:text="@string/BTVerify"
        android:layout_marginTop="@dimen/MarginTop"
        android:textSize="@dimen/TXSEasy"
        android:visibility="visible"
        />
</RelativeLayout>